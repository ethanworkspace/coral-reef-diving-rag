# Copy to .env only on your own machine. Never put a real key in Git or frontend code.
IAI_API_KEY=
# The provider endpoint and model identifiers are intentionally omitted.
# Set only user-approved values in a local, untracked .env when live evaluation is authorized.
IAI_BASE_URL=
IAI_CHAT_MODEL=
IAI_EMBEDDING_MODEL=
IAI_RERANKER_MODEL=

# A maximum age for live marine observations. This is a policy guard, not a safety guarantee.
MAX_LIVE_DATA_AGE_HOURS=6

# CWA general-weather products update every six hours. This is a freshness guard,
# not a weather, marine-condition, or safety guarantee.
GENERAL_WEATHER_MAX_DATA_AGE_HOURS=8

# CWA uses a separate member authorization code. Leave blank until you obtain one.
CWA_API_KEY=
