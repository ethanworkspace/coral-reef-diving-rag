# Copy to .env only on your own machine. Never put a real key in Git or frontend code.
IAI_API_KEY=
IAI_BASE_URL=https://www.iai.nkust.edu.tw/aihub
IAI_CHAT_MODEL=Furen-omni
IAI_EMBEDDING_MODEL=Embedding
IAI_RERANKER_MODEL=Furen-reranker

# A maximum age for live marine observations. This is a policy guard, not a safety guarantee.
MAX_LIVE_DATA_AGE_HOURS=6

# CWA uses a separate member authorization code. Leave blank until you obtain one.
CWA_API_KEY=
